# =============================================================================
# PrigeeX frontend environment
# Copy to .env.local and fill in.
#
# NOTE: Contract addresses live in packages/dex-config.ts (version-controlled).
# Subgraph queries are proxied through /api/subgraph/* so private URLs and
# tokens never reach the browser - set the server-only vars below.
# =============================================================================

# WalletConnect Cloud project id (required for the WalletConnect connector).
# Create one at https://cloud.walletconnect.com
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Network this build serves. Unset (default) = Arbitrum One (app.prigeex.com).
# Set to arbitrum-sepolia for the testnet build (testnet.prigeex.com). Inlined at
# build time, so the testnet site is its own build/deployment with this set.
NEXT_PUBLIC_PRIGEEX_NETWORK=

# RPC endpoint (server-only - never sent to the browser).
# The browser routes all JSON-RPC calls through /api/rpc which reads this var.
# Must be an endpoint for the network above. Defaults to the network's public
# Arbitrum RPC when unset.
RPC_URL=

# Optional RPC for wide eth_getLogs sweeps in /api/analytics (some providers cap
# the block range). Defaults to the network's public Arbitrum RPC.
RPC_LOGS_URL=

# =============================================================================
# Subgraph endpoints (server-only - never sent to the browser)
# Leave unset for the defaults: the public PrigeeX Goldsky subgraphs on Arbitrum
# One, or a local graph-node at localhost:8000 on arbitrum-sepolia.
# =============================================================================

# Goldsky (or any hosted Graph node) private URLs for the three subgraphs.
SUBGRAPH_URL_V3=
SUBGRAPH_URL_V2=
SUBGRAPH_URL_PROTOCOL=

# Bearer token for private Goldsky subgraphs (single token for all three).
SUBGRAPH_BEARER_TOKEN=

# Base URL for the docs site. Defaults to https://docs.prigeex.com.
NEXT_PUBLIC_DOCS_URL=

# Base URL for the marketing site (prigeex-web repo). Defaults to https://prigeex.com.
NEXT_PUBLIC_WEB_URL=
